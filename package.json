    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fastify": "^5.6.1",
    "sql.js": "^1.13.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/sql.js": "^1.4.9",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
