{
  "name": "sewfit-api",
  "version": "0.1.0",
  "private": true,
  "description": "家用缝纫机配件防撞试配纯后端 API（压脚 / 针板 / 转换柄）",
  "type": "module",
  "engines": {
    "node": ">=20.20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
